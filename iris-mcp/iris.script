zn "%SYS"
do ##class(SYS.Container).QuiesceForBundling()
zn "MCP"
set sc = $SYSTEM.OBJ.LoadDir("/opt/irisapp/src/External", "ck", , 1)
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.OBJ.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) set $ECODE=",U-BUILDFAILED,"
set sc = ##class(External.Demo.Bootstrap).Seed()
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.OBJ.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) set $ECODE=",U-BUILDFAILED,"
zn "%SYS"
// Web application (2) plus MCP server (16): both flags are required.
set properties("Type") = 18
set properties("NameSpace") = "MCP"
set properties("DispatchClass") = "External.MCP.Service"
set properties("Enabled") = 1
set properties("AutheEnabled") = 32
set properties("MatchRoles") = ":%All"
set sc = ##class(Security.Applications).Create("/mcp/demo", .properties)
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.OBJ.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) set $ECODE=",U-BUILDFAILED,"
halt
