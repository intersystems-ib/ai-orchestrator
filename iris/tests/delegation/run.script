zn "APP"
// Business examples are explicit test fixtures, never part of the core image.
set sc=$SYSTEM.OBJ.LoadDir("/tmp/test-demo","ck",,1)
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=##class(App.Demo.Inventory).SeedDemo(.created)
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=##class(App.Governance.Tool).Synchronize(.ignored)
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=$SYSTEM.OBJ.Load("/tmp/delegation-tests/Test.cls","ck")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set test=##class(App.Test.Delegation).%New()
set failures=test.Run()
halt
