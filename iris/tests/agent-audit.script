zn "APP"
set failures=0,prefix="audit-test-"_$translate($SYSTEM.Util.CreateGUID(),"{}","")
tstart
set first=##class(App.Governance.Agent).%New()
set first.Name=prefix_"-first",first.DisplayName="Audited agent",first.ModelName="fixture-model",first.Policies="database-audit,DATABASE-AUDIT"
set sc=first.%Save()
if '$SYSTEM.Status.IsOK(sc) {set failures=failures+1 write "FAIL audited agent fixture",!}
set second=##class(App.Governance.Agent).%New()
set second.Name=prefix_"-second",second.DisplayName="Agent without audit policy",second.ModelName="fixture-model"
set sc=second.%Save()
if '$SYSTEM.Status.IsOK(sc) {set failures=failures+1 write "FAIL second agent fixture",!}
set audit=##class(App.AIHub.Policy.DynamicAudit).%New()
set call={"name":(prefix),"arguments":{}},result={"ok":true}
do ##class(App.AIHub.RuntimeContext).SetAgent(first.Name)
set sc=audit.%LogExecution(call,{},result,15,1)
set rs=##class(%SQL.Statement).%ExecDirect(,"SELECT COUNT(*) AS Records FROM App_Governance.AuditEvent WHERE AgentName=?",first.Name)
do rs.%Next()
if rs.%Get("Records")'=1 {set failures=failures+1 write "FAIL agent audit or duplicate event",!}
do ##class(App.AIHub.RuntimeContext).SetAgent(second.Name)
set sc=audit.%LogExecution(call,{},result,15,1)
set rs=##class(%SQL.Statement).%ExecDirect(,"SELECT COUNT(*) AS Records FROM App_Governance.AuditEvent WHERE AgentName=?",second.Name)
do rs.%Next()
if rs.%Get("Records")'=0 {set failures=failures+1 write "FAIL unassigned audit policy applied",!}
set second.Policies="database-audit"
set sc=second.%Save()
set sc=audit.%LogExecution(call,{},result,15,1)
set rs=##class(%SQL.Statement).%ExecDirect(,"SELECT COUNT(*) AS Records FROM App_Governance.AuditEvent WHERE AgentName=?",second.Name)
do rs.%Next()
if rs.%Get("Records")'=1 {set failures=failures+1 write "FAIL dynamic agent policy assignment",!}
trollback
do ##class(App.AIHub.RuntimeContext).Clear()
write "AGENT_AUDIT_FAILURES=",failures,!
halt
