zn "%SYS"
kill jwtSettings
set jwtSettings("JWTIssuer") = "ai-orchestrator"
set jwtSettings("JWTSigAlg") = "ES256"
set sc = ##class(Security.System).Modify(, .jwtSettings)
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.OBJ.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) set $ECODE=",U-BUILDFAILED,"
do ##class(SYS.Container).QuiesceForBundling()

zn "APP"
set sc = $SYSTEM.OBJ.LoadDir("/opt/irisapp/src/App", "ck", , 1)
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.OBJ.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) set $ECODE=",U-BUILDFAILED,"
if $SYSTEM.Status.IsOK(sc) try { set sc = ##class(App.AIHub.Bootstrap).Seed() } catch exception { set sc = exception.AsStatus() }
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.OBJ.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) set $ECODE=",U-BUILDFAILED,"
halt

