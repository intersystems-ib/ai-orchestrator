zn "APP"
set sc=##class(Ens.Director).StopProduction(60,1)
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=$SYSTEM.OBJ.LoadDir("/opt/irisapp/src/App","ck",,1)
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=##class(App.AIHub.Upgrade.ContextBudgets).Run()
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=##class(Ens.Director).StartProduction("App.Interop.Production")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
write "CONTEXT_BUDGET_UPGRADE_OK",!
halt
