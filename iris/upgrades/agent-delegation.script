zn "APP"
set sc=$SYSTEM.OBJ.Load("/opt/irisapp/src/App/Governance/AgentDelegate.cls","ck")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=$SYSTEM.OBJ.Load("/opt/irisapp/src/App/AIHub/RuntimeContext.cls","ck")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=$SYSTEM.OBJ.Load("/opt/irisapp/src/App/AIHub/Delegation.cls","ck")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=$SYSTEM.OBJ.Load("/opt/irisapp/src/App/AIHub/Tool/DelegateAgent.cls","ck")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=$SYSTEM.OBJ.Load("/opt/irisapp/src/App/Governance/Agent.cls","ck")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=$SYSTEM.OBJ.Load("/opt/irisapp/src/App/AIHub/AgentFactory.cls","ck")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
write "AGENT_DELEGATION_UPGRADE_OK",!
halt
