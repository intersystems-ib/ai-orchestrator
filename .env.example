COMPOSE_PROJECT_NAME=ai-orchestrator

# Imagen de InterSystems IRIS con AI Hub instalada localmente.
IRIS_IMAGE=docker.iscinternal.com/docker-intersystems/intersystems/iris-community:2026.2.0AI.162.0
IRIS_WEB_PORT=52773
IRIS_SUPERSERVER_PORT=1972
WEBGATEWAY_HTTP_PORT=8080
WEBGATEWAY_HTTPS_PORT=8443
FRONTEND_PORT=5173
LLM_PORT=8000

# Llama local OpenAI-compatible.
LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLM_MODEL_FILE=Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
LLM_MODEL_ALIAS=llama-3.1-8b-instruct
LLM_CHAT_TEMPLATE=meta-llama-Llama-3.1-8B-Instruct.jinja

# Qwen local OpenAI-compatible. Comparte la carpeta ./models con Llama.
QWEN_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
QWEN_PORT=8001
QWEN_MODEL_FILE=Qwen3.5-9B-Q5_K_M.gguf
QWEN_MODEL_ALIAS=qwen3.5-9b
QWEN_CONTEXT_SIZE=4096
QWEN_THREADS=12
QWEN_TEMPERATURE=0.2

