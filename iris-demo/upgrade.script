zn "DEMO"
set sc=$SYSTEM.OBJ.LoadDir("/opt/irisapp/src","ck",,1)
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=##class(App.Demo.Inventory).%BuildIndices()
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=##class(App.Demo.Shipment).%BuildIndices()
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=##class(App.Demo.ShipmentProduct).%BuildIndices()
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
write "BUSINESS_PREVIEW_UPGRADE_OK",!
halt
