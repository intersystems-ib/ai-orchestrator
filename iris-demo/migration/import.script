zn "DEMO"
set sc=$SYSTEM.OBJ.Load("/tmp/demo-migration/LegacyData.cls","ck")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=##class(Demo.Migration.LegacyData).Import("/tmp/demo-data.jsonl")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
// Export again before translating to verify an exact data round trip on the host.
set sc=##class(Demo.Migration.LegacyData).Export("/tmp/demo-data-verified.jsonl")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
write "DEMO_IMPORT_OK",!
halt
