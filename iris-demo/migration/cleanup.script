zn "APP"
if '$data(^AppDemoSeparation("catalogReady")) { write "ERROR: MCP catalog is not ready",! halt }
if '$data(^AppDemoSeparation("dataVerified")) { write "ERROR: data copy has not been verified",! halt }
set sc=$SYSTEM.OBJ.Load("/tmp/demo-migration/Bootstrap.cls","ck")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
for class="App.Demo.ShipmentProduct","App.Demo.Shipment","App.Demo.Inventory" { if ##class(%Dictionary.CompiledClass).%ExistsId(class) { set sc=$classmethod(class,"%KillExtent") if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt } } }
set sc=$SYSTEM.OBJ.DeletePackage("App.Demo")
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
set sc=##class(App.Governance.Tool).Synchronize(.ignored)
if '$SYSTEM.Status.IsOK(sc) { do $SYSTEM.OBJ.DisplayError(sc) halt }
kill ^AppDemoSeparation
write "DEMO_CLEANUP_OK",!
halt
